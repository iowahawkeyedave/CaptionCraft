# AI API Configuration
# Choose your AI provider: openai, lmstudio, ollama, or mock
REACT_APP_AI_PROVIDER=mock

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# LM Studio Configuration
# Default LM Studio local server endpoint
REACT_APP_LMSTUDIO_URL=http://localhost:1234
# Optional: API key for LM Studio (usually not needed for local)
REACT_APP_LMSTUDIO_API_KEY=

# Ollama Configuration
# Default Ollama local server endpoint
REACT_APP_OLLAMA_URL=http://localhost:11434

# Model settings
REACT_APP_VISION_MODEL=gpt-4-vision-preview
REACT_APP_STORY_MODEL=gpt-4o